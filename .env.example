TOPSTEP_USERNAME=your_topstepx_username
TOPSTEP_API_KEY=your_projectx_api_key
TOPSTEP_ACCOUNT_ID=28504416
VERIFIED_PRACTICE_ACCOUNT_ID=28504416
VERIFIED_PRACTICE_ACCOUNT_NAME=PRAC-V2-647233-61822502
# Set true only after independently confirming this is simulated/practice in TopstepX.
PRACTICE_ACCOUNT_SIMULATED_VERIFIED=false
PROJECTX_LIVE_DATA=false
LOG_LEVEL=INFO

# Options: ema_cross, ema_touch_reentry, test_long, or quick_scalp
ACTIVE_STRATEGY=ema_cross
ENABLE_ORDER_EXECUTION=false
PRACTICE_ONLY=true
CONTRACTS=1
STOP_LOSS_POINTS=10
TRAIL_ACTIVATION_POINTS=3
TRAIL_DISTANCE_TICKS=4
TRAIL_MANAGEMENT_MODE=native_delayed
EXECUTION_POLL_INTERVAL_SECONDS=0.5
ENABLE_DAILY_LOSS_LIMIT=true
MAX_DAILY_LOSS_USD=100
MAX_OPEN_POSITIONS=1

# Required for the immediate 10-point API hard-stop bracket.
# Position Brackets reject stopLossBracket fields on Order/place.
BRACKET_MODE=auto_oco
# Keep true until every readiness and trailing-stop check is complete.
EMERGENCY_HALT=true

# Optional read-only Telegram monitoring
TELEGRAM_BOT_TOKEN=
# ema_touch_reentry settings (Pine Script defaults; existing strategies ignore them)
EMA_TOUCH_FAST_LENGTH=20
EMA_TOUCH_SLOW_LENGTH=50
EMA_TOUCH_ENABLE_CROSS_ENTRIES=true
EMA_TOUCH_ENABLE_TOUCH_ENTRIES=true
EMA_TOUCH_BLUE_EMA=true
EMA_TOUCH_RED_EMA=true
EMA_TOUCH_USE_DATE_FILTER=false
EMA_TOUCH_START_DATE=2026-06-05T00:00:00+00:00
EMA_TOUCH_END_DATE=2026-06-07T00:00:00+00:00
EMA_TOUCH_CONTRACTS=1
EMA_TOUCH_HARD_STOP_POINTS=3
EMA_TOUCH_TRAIL_ACTIVATION_POINTS=20
EMA_TOUCH_TRAIL_DISTANCE_POINTS=20

